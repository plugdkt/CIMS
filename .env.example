APP_NAME=CMIS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=cmis
DB_USERNAME=cmis_app
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_root

# Docker host-forwarded ports (used by docker-compose.yml, not by the app itself)
FORWARD_APP_PORT=8090
FORWARD_DB_PORT=3309
FORWARD_REDIS_PORT=6379
FORWARD_NGINX_PORT=8091

SESSION_DRIVER=redis
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=cmis_cache

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@cmis.local"
MAIL_FROM_NAME="${APP_NAME}"


# MEDSCI ACC SSO — register CMIS as a client with the faculty SSO admin to get real values.
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_LOGIN_URL=https://www.medsci.up.ac.th/msc_acc/sso/login.php
SSO_VERIFY_URL=https://www.medsci.up.ac.th/msc_acc/api/verify.php
SSO_LOGOUT_URL=https://www.medsci.up.ac.th/msc_acc/sso/logout.php
SSO_CALLBACK_URL=http://localhost:8090/sso/callback

VITE_APP_NAME="${APP_NAME}"
