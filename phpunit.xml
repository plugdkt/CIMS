<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            The container's CLI memory_limit is 128M, which the whole suite running in a
            single PHP process outgrows: PHPUnit/Pest hold every test object for the run,
            and the Excel writer then asks for a 16MB chunk in one go
            (zipstream-php/src/File.php) and dies with "Allowed memory size exhausted".
            It surfaced as an intermittent fatal partway through a full run — never when
            the export test was run on its own — which is exactly what accumulation looks
            like. Not a leak in app code: the real queued export raises its own limit to
            1536M (GenerateLedgerPdfExportJob), so only the harness needed headroom.
        -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_URL" value="http://localhost"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            No sqlite override: migrations use MariaDB-specific CHECK constraints and
            triggers (append-only stock_ledger/audit_logs), which sqlite can't run at all.
            DB_DATABASE points at a dedicated `cmis_testing` database, NOT the shared dev
            `cmis` one — RefreshDatabase's *first* run in a process calls migrate:fresh,
            which is DDL (auto-commits, not transactional), so it is NOT undone by the
            per-test transaction rollback. Sharing the dev database with tests meant every
            `php artisan test` run silently wiped real dev data (learned the hard way:
            wiped a manually-granted ADMIN role and all seed data). See CLAUDE.md.
        -->
        <env name="DB_DATABASE" value="cmis_testing"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!--
            Dummy, non-empty value so ChemicalSpecificationAiService's app()-resolved
            singleton (ChemicalSpecificationAiControllerTest, GenerateAiSpecificationsCommandTest)
            doesn't short-circuit before Http::fake() ever gets a chance to intercept the
            call — the real .env key is never present in a fresh clone/CI, and these tests
            must not depend on it being set. Tests that need an empty/null key construct
            the service directly instead (ChemicalSpecificationAiServiceTest).
        -->
        <env name="AI_GATEWAY_API_KEY" value="phpunit-dummy-key"/>
    </php>
</phpunit>
